# Local development only. Never add real credentials to this file.
APP_ENV=local
LOG_LEVEL=INFO
APP_NAME=Enterprise GenAI Agent Gateway
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MODEL_PROVIDER=mock
MAX_WORKFLOW_STEPS=8
MODEL_GATEWAY_PROVIDER=mock
MODEL_GATEWAY_ALLOWLIST=["mock-deterministic"]
MODEL_GATEWAY_TIMEOUT_SECONDS=20
MODEL_GATEWAY_MAX_ATTEMPTS=2
MODEL_GATEWAY_DAILY_BUDGET_GBP=5.0
# Required only when MODEL_GATEWAY_PROVIDER=azure_openai. Authentication is
# keyless (DefaultAzureCredential / workload identity); no API key is read here.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
PII_PROTECTION_ENABLED=true
PII_MASK_ENTITIES=["PERSON","EMAIL_ADDRESS","PHONE_NUMBER","IP_ADDRESS"]
PII_BLOCK_ENTITIES=["CREDIT_CARD","IBAN_CODE","US_SSN","UK_SORT_CODE"]
PII_SCORE_THRESHOLD=0.5
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_PROVIDER=mock
CONTENT_SAFETY_THRESHOLDS={"Hate":4,"SelfHarm":4,"Sexual":4,"Violence":4}
# Required only when CONTENT_SAFETY_PROVIDER=azure. Authentication is keyless
# (DefaultAzureCredential / workload identity); no API key is read here.
CONTENT_SAFETY_ENDPOINT=
MCP_TOOL_TIMEOUT_SECONDS=2
MCP_MAX_ATTEMPTS=2
MCP_RATE_LIMIT=30
MCP_RATE_WINDOW_SECONDS=60
STATE_DATABASE_PATH=:memory:
STATE_BACKEND=sqlite
STATE_CONNECTION_URL=
OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
METRICS_ENABLED=true
# Required by Docker Compose. Set only in the gitignored .env file.
GRAFANA_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Required only for the optional `langfuse` Compose profile (ADR-007),
# self-hosted LLM observability. Demo-week-only; set only in the gitignored
# .env file. LANGFUSE_OTLP_BASIC_AUTH is base64("<public-key>:<secret-key>")
# built from the LANGFUSE_INIT_PROJECT_* pair below.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_OTLP_BASIC_AUTH=
# Required only for explicitly approved connected Azure operations.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_STATE_STORAGE_ACCOUNT=
