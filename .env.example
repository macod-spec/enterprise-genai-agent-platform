# Local development only. Never add real credentials to this file.
APP_ENV=local
LOG_LEVEL=INFO
APP_NAME=Enterprise GenAI Agent Gateway
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MODEL_PROVIDER=mock
MAX_WORKFLOW_STEPS=8
MCP_TOOL_TIMEOUT_SECONDS=2
MCP_MAX_ATTEMPTS=2
MCP_RATE_LIMIT=30
MCP_RATE_WINDOW_SECONDS=60
STATE_DATABASE_PATH=:memory:
STATE_BACKEND=sqlite
STATE_CONNECTION_URL=
OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
METRICS_ENABLED=true
# Required by Docker Compose. Set only in the gitignored .env file.
GRAFANA_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Required only for explicitly approved connected Azure operations.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_STATE_STORAGE_ACCOUNT=
